# The warmer's user unit (docs/api.md, "The deployed service"). A deployment links it from the deploy
# tree and restarts it as the repository's one service; it runs the release binary, which reads its
# address, its store and its token file from the release's settings.toml, linked to the data root's.
[Unit]
Description=bmo-cache-warmer: keeps registered prompt-cache prefixes warm
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bmo-cache-warmer/deploy
# The store's file is made where missing, its folder is not.
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/bmo-cache-warmer/data
ExecStart=%h/.local/share/bmo-cache-warmer/deploy/bin/bmo-cache-warmer
Restart=on-failure
RestartSec=5
# The service drains on SIGTERM and ends by its own drain deadline (docs/api.md, "The service"); a stop
# waits for that end and is never escalated to a kill.
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
X-BMO-Deploy=bot
